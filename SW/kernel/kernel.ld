MEMORY
{
    RAM (rwx) : ORIGIN = 0x80000000, LENGTH = 128M
}

ENTRY(_start)

SECTIONS
{
    /* -------------------------------------------------- */
    /* Kernel entry point (QEMU reset PC)                 */
    /* -------------------------------------------------- */
    . = ORIGIN(RAM);

    .text.entry :
    {
        KEEP(*(.text.entry))
    } > RAM

    /* -------------------------------------------------- */
    /* Kernel text                                       */
    /* -------------------------------------------------- */
    .text :
    {
        *(.text*)
    } > RAM

    /* -------------------------------------------------- */
    /* Trampoline (placed AFTER kernel text)              */
    /* -------------------------------------------------- */
    . = ALIGN(0x1000);        /* page-align is important */
    .trampoline :
    {
        __trampoline_start = .;
        KEEP(*(.trampoline))
        __trampoline_end = .;
    } > RAM

    /* -------------------------------------------------- */
    /* Read-only data                                    */
    /* -------------------------------------------------- */
    .rodata :
    {
        . = ALIGN(0x10);
        *(.rodata*)
        *(.srodata*)
    } > RAM

    /* -------------------------------------------------- */
    /* Initialized data                                  */
    /* -------------------------------------------------- */
    .data :
    {
        . = ALIGN(0x1000);
        *(.data*)
        *(.sdata*)
    } > RAM

    /* -------------------------------------------------- */
    /* Zero-initialized data                             */
    /* -------------------------------------------------- */
    .bss :
    {
        . = ALIGN(0x100);
        *(.bss*)
        *(.sbss*)
        *(COMMON)
    } > RAM

    /* -------------------------------------------------- */
    /* End-of-kernel markers                             */
    /* -------------------------------------------------- */
    _stack_top = ORIGIN(RAM) + LENGTH(RAM);
    . = ALIGN(0x10);
    _end = .;
}
